# Copy to server as .env.production (never commit real values)

REGISTRY=us-central1-docker.pkg.dev/YOUR_GCP_PROJECT/todo
IMAGE_TAG=latest

HTTP_PORT=80

APP_NAME=Todo API
APP_URL=https://yourdomain.com
APP_DEBUG=false

# GCP Cloud SQL — production instance
DB_HOST=10.x.x.x
DB_PORT=3306
DB_DATABASE=todo_prod
DB_USERNAME=todo_prod_user
DB_PASSWORD=change_me

CORS_ALLOWED_ORIGINS=https://yourdomain.com
TOKEN_TTL_DAYS=7

# GCP_PROJECT=your-project
# GCP_REGION=us-central1
# CLOUD_SQL_INSTANCE_PROD=your-project:us-central1:todo-prod
