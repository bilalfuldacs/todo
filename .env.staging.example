# Copy to server as .env.staging (never commit real values)

REGISTRY=us-central1-docker.pkg.dev/YOUR_GCP_PROJECT/todo
IMAGE_TAG=staging

HTTP_PORT=8080

APP_NAME=Todo API
APP_URL=https://staging.yourdomain.com
APP_DEBUG=false

# GCP Cloud SQL — staging instance
DB_HOST=10.x.x.x
DB_PORT=3306
DB_DATABASE=todo_staging
DB_USERNAME=todo_staging_user
DB_PASSWORD=change_me

CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com
TOKEN_TTL_DAYS=7

# Optional Cloud SQL Proxy
# GCP_PROJECT=your-project
# GCP_REGION=us-central1
# CLOUD_SQL_INSTANCE_STAGING=your-project:us-central1:todo-staging
